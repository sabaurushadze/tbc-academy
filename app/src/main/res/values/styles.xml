<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="EditTextOutlined">
        <item name="android:background">@drawable/et_border</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="ButtonOutlined">
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/btn_round_outlined_6dp</item>
        <item name="android:textColor">@color/black2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="ButtonPrimaryFilled">
        <item name="android:background">@drawable/btn_round_6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>